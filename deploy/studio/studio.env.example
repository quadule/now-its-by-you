# Copy to deploy/studio/.env (never committed) and fill in. docs/WEB-STUDIO.md explains each.

# The tunnel's token: Cloudflare dashboard > Zero Trust > Networks > Tunnels > (the tunnel) > the
# connector's install command, the long string after --token.
TUNNEL_TOKEN=

# The name visitors use; the tunnel's public hostname must be this name.
STUDIO_HOST=studio.itsby.you

# Who shapes the song for everyone: none (a neutral machine) or fictional:NAME. Never "here".
STUDIO_MACHINE=none

# The container's memory (no swap on top), CPUs, and a render's threads. On the VPS beside mailcow:
# 2500m, 2, 2. The studio refuses a whole song estimated past STUDIO_MEMORY less 400 MB (its length and players;
# docs/WEB-STUDIO.md, "A whole song's memory"): more memory, longer songs on the server.
STUDIO_MEMORY=2500m
STUDIO_CPUS=2
SONGBIRD_THREADS=2

# More of the studio's arguments: its limits as --limit NAME=N (names and defaults: docs/WEB-STUDIO.md),
# and, for a closed beta by link instead of Cloudflare Access, --key A-LONG-WORD.
STUDIO_ARGS=--limit records=4 --limit records-ip=10 --limit queue=12 --limit cache-mb=300 --limit downloads-mb=1024

# Singing in the browser (docs/WEB-SINGING.md): the studio's arguments for it (its guides and template analyses are
# made as they're needed, in the studio's data). Set STUDIO_SINGING to a space ( ) to turn it off; STUDIO_ARGS can
# hold --limit takes=N (takes measured an hour each).
STUDIO_SINGING=--web-singing

# The song made in the visitor's browser where it can be (docs/WEB-STUDIO.md, "Made in the visitor's browser"): the
# bundle the image built, served to desktop browsers, the server making it for phones and whenever a browser can't.
# Set STUDIO_BROWSER to a space ( ) to have the server make every song.
STUDIO_BROWSER=--browser-render /opt/studio/render

# While it's a beta: every reply asks search engines not to list the studio (X-Robots-Tag: noindex, and a robots.txt
# disallowing everything). Set STUDIO_NOINDEX to a space ( ) once it's open for good.
STUDIO_NOINDEX=--noindex
