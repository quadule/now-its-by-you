# Copy to deploy/studio/.env (never committed) and fill in. docs/WEB-STUDIO.md explains each.

# The tunnel's token: Cloudflare dashboard > Zero Trust > Networks > Tunnels > (the tunnel) > the
# connector's install command, the long string after --token.
TUNNEL_TOKEN=

# The name visitors use; the tunnel's public hostname must be this name.
STUDIO_HOST=studio.itsby.you

# Who shapes the song for everyone: none (a neutral machine) or fictional:NAME. Never "here".
STUDIO_MACHINE=none

# The container's memory (no swap on top), CPUs, and a render's threads. On the VPS beside mailcow:
# 2500m, 2, 2. A whole render must fit under STUDIO_MEMORY with room to spare (docs/WEB-STUDIO.md).
STUDIO_MEMORY=2500m
STUDIO_CPUS=2
SONGBIRD_THREADS=2

# More of the studio's arguments: its limits as --limit NAME=N (names and defaults: docs/WEB-STUDIO.md),
# and, for a closed beta by link instead of Cloudflare Access, --key A-LONG-WORD.
STUDIO_ARGS=--limit records=4 --limit records-ip=10 --limit queue=12 --limit cache-mb=300 --limit downloads-mb=1024

# Singing in the browser (docs/WEB-SINGING.md): the studio's arguments for it, and where the singing kit is on this
# host (made with `uv run python -m webstudio.prepare` by the same program as the image, then copied here). Set
# STUDIO_SINGING to a space ( ) to turn it off; STUDIO_ARGS can hold --limit takes=N (takes measured an hour each).
STUDIO_SINGING=--web-singing --sing-kit /kit
SING_KIT=../../renders/sing-kit
