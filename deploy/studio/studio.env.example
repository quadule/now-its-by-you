# Copy to deploy/studio/.env (never committed) and fill in. docs/WEB-STUDIO.md explains each.

# The tunnel's token: Cloudflare dashboard > Zero Trust > Networks > Tunnels > (the tunnel) > the
# connector's install command, the long string after --token.
TUNNEL_TOKEN=

# The name visitors use; the tunnel's public hostname must be this name.
STUDIO_HOST=studio.itsby.you

# Who shapes the song for everyone: none (a neutral machine) or fictional:NAME. Never "here".
STUDIO_MACHINE=none

# The container's memory (no swap on top), CPUs, and a render's threads. On the VPS beside mailcow:
# 2500m, 2, 2. A whole render must fit under STUDIO_MEMORY with room to spare (docs/WEB-STUDIO.md).
STUDIO_MEMORY=2500m
STUDIO_CPUS=2
SONGBIRD_THREADS=2

# A public studio's limits, as --limit NAME=N flags (names and defaults: docs/WEB-STUDIO.md).
STUDIO_LIMITS=--limit records=4 --limit records-ip=10 --limit queue=12 --limit cache-mb=300 --limit downloads-mb=1024
