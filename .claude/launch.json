{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "karaoke",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "tools/karaoke.py",
        "songs/h-now-its-by-you.json"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    },
    {
      "name": "studio",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "songbird",
        "studio",
        "--no-open"
      ],
      "port": 8766,
      "url": "http://127.0.0.1:8766"
    },
    {
      "name": "site",
      "runtimeExecutable": "web/sing/node_modules/.bin/wrangler",
      "runtimeArgs": [
        "dev",
        "-c",
        "web/sing/wrangler.toml",
        "--port",
        "8767",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8767,
      "url": "http://127.0.0.1:8767"
    },
    {
      "name": "piano",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8770",
        "--bind",
        "127.0.0.1",
        "--directory",
        "web"
      ],
      "port": 8770,
      "url": "http://127.0.0.1:8770"
    },
    {
      "name": "studio-public",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "songbird",
        "studio",
        "--public",
        "--machine",
        "fictional:wren",
        "--port",
        "8768",
        "--no-open"
      ],
      "port": 8768,
      "url": "http://127.0.0.1:8768"
    },
    {
      "name": "studio-singing",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "songbird",
        "studio",
        "--public",
        "--web-singing",
        "--machine",
        "fictional:wren",
        "--port",
        "8769",
        "--no-open"
      ],
      "port": 8769,
      "url": "http://127.0.0.1:8769"
    }
  ]
}
